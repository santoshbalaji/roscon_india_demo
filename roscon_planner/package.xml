<?xml version="1.0"?>
<package format="3">
  <name>roscon_planner</name>
  <version>0.1.0</version>
  <description>Selectable OMPL planners and trajectory refiners with runtime collision checks and an RViz panel.</description>
  <maintainer email="selvarajs@artc.a-star.edu.sg">Santosh</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>roscon_kinematics</depend>
  <depend>roscon_collision</depend>
  <depend>roscon_msgs</depend>
  <depend>ompl</depend>
  <depend>stomp</depend>
  <depend>eigen</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>interactive_markers</depend>
  <exec_depend>roscon_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>roscon_rviz_plugins</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
