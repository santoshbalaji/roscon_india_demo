<?xml version="1.0"?>
<package format="3">
  <name>roscon_gearbox_demo</name>
  <version>0.1.0</version>
  <description>Gearbox assembly fixture and repeatable ABB motion planning checks.</description>
  <maintainer email="selvarajs@artc.a-star.edu.sg">Santosh</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>roscon_planner</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>roscon_description</exec_depend>
  <exec_depend>roscon_rviz_plugins</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
